{
  "name": "importify-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-drizzle.cjs",
    "start": "node dist/main.js",
    "start:dev": "nodemon --legacy-watch --watch src --ext ts --exec node -r ts-node/register src/main.ts",
    "start:debug": "node --inspect -r ts-node/register src/main.ts",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "test": "jest --config test/jest.e2e.js --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "@types/multer": "^2.3.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2"
  }
}
