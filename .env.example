MYSQL_ROOT_PASSWORD=root
MYSQL_USER=importify
MYSQL_PASSWORD=importify
MYSQL_DATABASE=importify
MYSQL_PORT=3306
DATABASE_URL=mysql://importify:importify@localhost:3306/importify
# Base separada para las suites e2e (se vacía en cada ejecución).
TEST_DATABASE_URL=mysql://importify:importify@localhost:3306/importify_test
APP_PORT=3001
APPWEB_PORT=3000
# En Hostinger, dejar que la plataforma asigne el puerto (PORT) y ejecutar
# migraciones al arrancar. En local/Docker puede quedar en false.
# RUN_MIGRATIONS_ON_START=false
NEXT_PUBLIC_API_URL=http://localhost:3001/api
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-in-your-local-env
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WOMPI_ENV=sandbox
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# SMTP (envío de códigos OTP al correo del administrador)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Subida de imagenes (opcional en Hostinger; usar ruta persistente fuera del release)
UPLOAD_DIR=
